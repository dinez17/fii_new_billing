{
  "openapi": "3.0.3",
  "info": {
    "title": "FII WAPI invoice integration subset",
    "version": "1.0.0",
    "description": "Subset transcribed from https://wapi.fiitech.in/api-docs; provider documentation reviewed 2026-11-01. Mock responses do not verify live delivery."
  },
  "servers": [
    {
      "url": "https://wapi.fiitech.in"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/v1/send/document": {
      "post": {
        "operationId": "post_api_v1_send_document",
        "responses": {
          "200": {
            "description": "Provider response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "messageId": 42,
                  "status": "completed",
                  "sent": 1,
                  "failed": 0
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "documentBase64",
                  "fileName",
                  "recipients"
                ],
                "properties": {
                  "documentBase64": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  },
                  "recipients": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "deviceId": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/messages/{id}": {
      "get": {
        "operationId": "get_api_v1_messages_id",
        "responses": {
          "200": {
            "description": "Provider response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "messageId": 42,
                  "status": "completed",
                  "sent": 1,
                  "failed": 0
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/account": {
      "get": {
        "operationId": "get_api_v1_account",
        "responses": {
          "200": {
            "description": "Provider response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "isActive": true,
                  "credits": 1000
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "get_api_v1_devices",
        "responses": {
          "200": {
            "description": "Provider response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "devices": [
                    {
                      "id": 1,
                      "name": "Test device",
                      "status": "connected",
                      "isReady": true
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}