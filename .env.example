# ── Database
DATABASE_URL="postgresql://fii:fii_dev_password@localhost:5432/fii_billing?schema=public"
POSTGRES_PASSWORD=replace_with_a_long_random_password
PROD_DATABASE_URL="postgresql://fii:replace_with_url_encoded_password@postgres:5432/fii_billing?schema=public"

# ── JWT (RS256) — generate:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
JWT_ISSUER=fii-billing
JWT_AUDIENCE=fii-billing-web

# ── Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fii-billing

# ── Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace_with_a_long_random_password
PROD_REDIS_URL=redis://:replace_with_url_encoded_password@redis:6379

# ── Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fii_minio
S3_SECRET_KEY=replace_with_a_long_random_secret
S3_BUCKET=fii-billing

# ── Secrets encryption (AES-256-GCM) — generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=replace_with_64_hex_chars

# ── Seed
SEED_TENANT_ADMIN_EMAIL=admin@demo.local
SEED_TENANT_ADMIN_PASSWORD=ChangeMe@123
SEED_PLATFORM_ADMIN_EMAIL=superadmin@platform.local
SEED_PLATFORM_ADMIN_PASSWORD=replace_with_at_least_16_random_characters
SEED_DEMO_TENANT=demo

# ── Server timezone (all containers + Postgres)
TZ=Asia/Kolkata

# ── Public production endpoints / email
ADMIN_DOMAIN=billing.example.com
PORTAL_DOMAIN=portal.example.com
APP_PUBLIC_URL=https://billing.example.com
ACME_EMAIL=admin@example.com
SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_FROM=no-reply@example.com
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_password

# ── Encrypted off-host backups
BACKUP_AGE_RECIPIENT=age1replace_with_offline_public_recipient
BACKUP_S3_URI=s3://replace-with-versioned-backup-bucket/fii-billing
